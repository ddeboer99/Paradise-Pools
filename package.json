{
  "name": "paradise-pools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4173",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4173",
    "check:site": "node scripts/check-site.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:media": "node scripts/check-media.mjs",
    "prepare:images": "node scripts/prepare-images.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview:functions": "wrangler pages dev dist --ip 127.0.0.1 --port 4174"
  },
  "dependencies": {
    "astro": "7.4.11"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "wrangler": "4.160.1"
  }
}
