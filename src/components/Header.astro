---
import { routePaths } from '../data/routes.js';
const { route } = Astro.props;
const links = [
  ['new-pools', 'New pools'], ['pool-service', 'Pool service'],
  ['automatic-covers', 'Pool covers'], ['equipment', 'Equipment'],
  ['chemicals', 'Water care'], ['about-us', 'Our story'], ['locations', 'Retail Locations'],
];
---
<a class="skip-link" href="#main">Skip to content</a>
<div class="topline"><span>Pool construction, service &amp; supply in Michiana</span><span>Local know-how, since 1963</span></div>
<header class="site-header">
  <a class="brand" href="/" aria-label="Paradise Pools home">
    <img class="brand-logo" src="/assets/paradise-pools-logo.png" alt="Paradise Pools" width="300" height="257" />
  </a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map(([id, label]) => <a href={routePaths[id]} class:list={{ active: route === id }} aria-current={route === id ? 'page' : undefined}>{label}</a>)}
  </nav>
  <a class="header-call" href="tel:+15742642488"><span>Talk with our team</span><strong>(574) 264-2488</strong></a>
  <a class="header-contact" href="/contact/">Contact <span aria-hidden="true">&#8594;</span></a>
  <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-navigation"><span></span><span></span></button>
  <nav class="mobile-nav" id="mobile-navigation" aria-label="Mobile navigation" hidden>
    {[...links, ['contact', 'Contact']].map(([id, label]) => <a href={routePaths[id]} aria-current={route === id ? 'page' : undefined}>{label}</a>)}
    <div class="mobile-nav-phones"><a href="tel:+15742642488">Elkhart (574) 264-2488</a><a href="tel:+15742776444">Granger (574) 277-6444</a></div>
  </nav>
</header>
