---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import business from '../data/business.json';
import '../styles/site.css';
const { title, description, route, noindex = false } = Astro.props;
const indexable = import.meta.env.PUBLIC_SITE_INDEXABLE === 'true' && !noindex;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#082c3b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
  </head>
  <body data-route={route} data-turnstile-site-key={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || undefined}>
    <Header route={route} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script src="../scripts/site.js"></script>
  </body>
</html>
